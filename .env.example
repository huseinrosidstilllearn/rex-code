++ # Rex Code Environment Configuration
++ # Copy this file to .env and fill in your API keys
++ 
++ # LLM Providers (at least one required)
++ # GEMINI_API_KEY=your_gemini_api_key_here
++ # OPENAI_API_KEY=your_openai_api_key_here
++ # ANTHROPIC_API_KEY=your_anthropic_api_key_here
++ 
++ # Optional: Custom OpenAI-compatible provider
++ # CUSTOM_OPENAI_BASE_URL=https://your-proxy.example.com/v1
++ # CUSTOM_OPENAI_API_KEY=your_custom_key
++ 
++ # Voice/Transcription (optional)
++ # WHISPER_API_KEY=your_openai_whisper_key
++ 
++ # GitHub Webhook (optional)
++ # GITHUB_WEBHOOK_SECRET=your_webhook_secret
++ # GITHUB_TOKEN=your_github_token
++ 
++ # Logging
++ # LOG_LEVEL=INFO